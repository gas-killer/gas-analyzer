    "rawMetadata": "{\"compiler\":{\"version\":\"0.8.30+commit.73712a01\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_implementation\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[],\"name\":\"DeploymentFailed\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"InvalidArguments\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"index\",\"type\":\"uint256\"},{\"internalType\":\"address\",\"name\":\"target\",\"type\":\"address\"},{\"internalType\":\"bytes\",\"name\":\"revertData\",\"type\":\"bytes\"},{\"internalType\":\"bytes\",\"name\":\"callargs\",\"type\":\"bytes\"}],\"name\":\"RevertingContext\",\"type\":\"error\"},{\"stateMutability\":\"payable\",\"type\":\"fallback\"},{\"inputs\":[{\"internalType\":\"enum StateUpdateType[]\",\"name\":\"types\",\"type\":\"uint8[]\"},{\"internalType\":\"bytes[]\",\"name\":\"args\",\"type\":\"bytes[]\"}],\"name\":\"runStateUpdatesCall\",\"outputs\":[],\"stateMutability\":\"payable\",\"type\":\"function\"},{\"stateMutability\":\"payable\",\"type\":\"receive\"}],\"devdoc\":{\"errors\":{\"RevertingContext(uint256,address,bytes,bytes)\":[{\"params\":{\"callargs\":\"The calldata that was passed to the failed call\",\"index\":\"The zero-based position of the failing operation in the batch\",\"revertData\":\"The raw revert data returned by the failed call\",\"target\":\"The contract address that was called\"}}]},\"kind\":\"dev\",\"methods\":{},\"stateVariables\":{\"IMPL_SLOT\":{\"details\":\"Isolated storage slot for the implementation address. keccak256(\\\"gas.estimator.implementation\\\") - 1\"}},\"version\":1},\"userdoc\":{\"errors\":{\"DeploymentFailed()\":[{\"notice\":\"Thrown when a CREATE or CREATE2 operation returns address(0)\"}],\"InvalidArguments()\":[{\"notice\":\"Thrown when `types` and `args` arrays have different lengths\"}],\"RevertingContext(uint256,address,bytes,bytes)\":[{\"notice\":\"Thrown when a CALL operation's external call reverts\"}]},\"kind\":\"user\",\"methods\":{},\"notice\":\"Gas estimator with transparent-proxy fallback. When injected into the simulation at the original contract's address, this contract handles `runStateUpdatesCall` for gas measurement and forwards every other call (e.g. callbacks from oracles or AMMs) to the original implementation via DELEGATECALL, preserving `address(this)`, `msg.sender`, and storage context. The implementation address is stored in an EIP-1967-style isolated storage slot to avoid colliding with the original contract's storage layout when the fallback DELEGATECALLs into the backup bytecode. Rust bypasses the constructor: it loads the deployed bytecode directly from the Foundry artifact and writes `backup_addr` to IMPL_SLOT via `insert_account_storage`.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/StateChangeHandlerGasEstimator.sol\":\"StateChangeHandlerGasEstimator\"},\"evmVersion\":\"prague\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":false,\"runs\":200},\"remappings\":[\":@eigenlayer-middleware/=lib/solidity-sdk/lib/eigenlayer-middleware/src/\",\":@openzeppelin-upgradeable/=lib/solidity-sdk/lib/openzeppelin-contracts-upgradeable/\",\":@openzeppelin/=lib/solidity-sdk/lib/openzeppelin-contracts/\",\":forge-std/=lib/forge-std/src/\",\":gk/=lib/solidity-sdk/src/\",\":solidity-sdk/=lib/solidity-sdk/src/\"]},\"sources\":{\"lib/solidity-sdk/src/StateChangeHandlerLib.sol\":{\"keccak256\":\"0xbe136129de4ac9430b896c51a9aac3bc5b64cd55ad3f618d7f7add8f60a26353\",\"license\":\"AGPL-3.0-only\",\"urls\":[\"bzz-raw://a46104eef971b2d02628d3342932af59b47d18ef811fb3bae6cd94edca5e1396\",\"dweb:/ipfs/QmcQaCSrJFqQPfetJ3rFnuA82gJQXzdmx4ay3XuGNGNd2e\"]},\"src/StateChangeHandlerGasEstimator.sol\":{\"keccak256\":\"0xf6673bb9caf44c3fc55c829a1c47552352eecda34887f14acfbec213966d0a39\",\"license\":\"UNLICENSED\",\"urls\":[\"bzz-raw://18a030fca843404c735ff210b27802e52cc176a8f