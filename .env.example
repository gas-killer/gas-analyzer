# =============================================================================
# Gas-analyzer CLI / docker-compose.test.yml
# =============================================================================

# Required by the CLI and the legacy test docker-compose.test.yml
RPC_URL=

# Required when running the Anvil test docker-compose
FORK_URL=

# Required by Anvil-mode block analysis
OUTPUT_FILE=

# =============================================================================
# Indexer service (docker-compose.yml)
# =============================================================================

# --- required ---
# Postgres password — used by the postgres container and connection strings.
POSTGRES_PASSWORD=

# --- chain ---
# One indexer-service deployment per chain. Default is Ethereum mainnet (1).
CHAIN_ID=1

# --- RPC rate limiting (top priority) ---
# Sustained tokens-per-second budget. Aim for ~30-40% of provider plan ceiling
# (CU/s on Alchemy-style plans). Conservative default leaves room for spikes
# and for the EvmSketch internal storage reads that bypass the limiter.
RPC_RPS_BUDGET=100
# Burst allowance for short spikes.
RPC_BURST=25
# Hard cap on simultaneous outbound RPC operations.
RPC_MAX_CONCURRENCY=8

# --- analysis filtering ---
# Skip transactions with gas_used below this. Default mirrors README intent.
MIN_GAS_USED=50000

# --- queue / head tracker ---
# Pause enqueueing while pending queue exceeds this many jobs.
MAX_QUEUE_DEPTH=1000
# How often the head-tracker probes the chain head, in milliseconds.
HEAD_POLL_MS=4000

# --- workers ---
# Per-worker retries on transient failure before dead-lettering.
WORKER_MAX_RETRIES=3

# --- refresher ---
# Empty values disable the corresponding refresh.
DEFILLAMA_URL=https://api.llama.fi/protocols
PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd
# Refresh cadences in seconds.
RESOLVER_REFRESH_SECS=86400
PRICE_REFRESH_SECS=3600
ROLLUP_REFRESH_SECS=3600

# --- logging ---
RUST_LOG=info

# =============================================================================
# Indexer web UI (docker-compose.yml indexer-web service)
# =============================================================================

# HMAC secret for session cookies. Must be at least 32 bytes. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Block-explorer base URLs (default: Ethereum mainnet / Etherscan).
# Trailing slash matters — the web UI appends the tx hash / address directly.
EXPLORER_TX_URL=https://etherscan.io/tx/
EXPLORER_ADDRESS_URL=https://etherscan.io/address/
