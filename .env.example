# =============================================================================
# Gas-analyzer CLI / docker-compose.test.yml
# =============================================================================

# Required by the CLI and the legacy test docker-compose.test.yml
RPC_URL=

# Required when running the Anvil test docker-compose
FORK_URL=

# Required by Anvil-mode block analysis
OUTPUT_FILE=

# =============================================================================
# Indexer service (docker-compose.yml)
# =============================================================================

# --- required ---
# Postgres password — used by the postgres container and connection strings.
POSTGRES_PASSWORD=

# --- chain ---
# One indexer-service deployment per chain. Default is Ethereum mainnet (1).
CHAIN_ID=1

# --- RPC rate limiting (top priority) ---
# The AUTHORITATIVE limit is the rpc-proxy service (nginx) in docker-compose.yml:
# the indexer's RPC_URL points at it, so EVERY upstream call — including the
# EvmSketch eth_getStorageAt reads that bypass the in-process limiter below —
# is rate-limited at the network boundary. Tune the upstream request rate here
# (requests/sec; keep well under the provider plan ceiling, e.g. <50/s):
RPC_PROXY_RATE=40
#
# The in-process token bucket (below) is now a coarse backstop behind the proxy.
# Sustained tokens-per-second budget:
RPC_RPS_BUDGET=100
# Burst = bucket capacity. MUST be >= weights::ANALYZE_TX (250) or every analysis
# is clamped/under-charged (you'll see "weight exceeds burst; clamping" in logs).
RPC_BURST=250
# Hard cap on simultaneous outbound RPC operations.
RPC_MAX_CONCURRENCY=8

# --- analysis filtering ---
# Skip transactions with gas_used below this. Default mirrors README intent.
MIN_GAS_USED=50000

# --- queue / head tracker ---
# Pause enqueueing while pending queue exceeds this many jobs.
MAX_QUEUE_DEPTH=1000
# How often the head-tracker probes the chain head, in milliseconds.
HEAD_POLL_MS=4000

# --- workers ---
# Per-worker retries on transient failure before dead-lettering.
WORKER_MAX_RETRIES=3

# --- refresher ---
# Empty values disable the corresponding refresh.
DEFILLAMA_URL=https://api.llama.fi/protocols
PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd
# Refresh cadences in seconds.
RESOLVER_REFRESH_SECS=86400
PRICE_REFRESH_SECS=3600
ROLLUP_REFRESH_SECS=3600

# --- auto-labeler ---
# Etherscan API key. If empty, the labeler is disabled. Free key from
# https://etherscan.io/myapikey (5 rps, 100k req/day — plenty for v1).
ETHERSCAN_API_KEY=
# How often the producer rebuilds its priority queue from the analysis table.
LABELER_PRODUCER_INTERVAL_SECS=3600
# Max addresses pushed into the queue on each producer tick.
LABELER_BATCH_SIZE=200
# Re-attempt failed addresses after this many days (handles newly-verified
# contracts and dictionary expansions).
LABELER_RETRY_DAYS=7
# Floor delay between Etherscan calls (ms). Free tier is 5 rps.
LABELER_MIN_DELAY_MS=250

# --- logging ---
RUST_LOG=info

# =============================================================================
# Indexer web UI (docker-compose.yml indexer-web service)
# =============================================================================

# HMAC secret for session cookies. Must be at least 32 bytes. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Block-explorer base URLs (default: Ethereum mainnet / Etherscan).
# Trailing slash matters — the web UI appends the tx hash / address directly.
EXPLORER_TX_URL=https://etherscan.io/tx/
EXPLORER_ADDRESS_URL=https://etherscan.io/address/

# =============================================================================
# Sepolia stack (docker-compose.sepolia.yml)
# =============================================================================
# A second, fully-isolated deployment for Ethereum Sepolia (chain 11155111).
# It reuses POSTGRES_PASSWORD / SESSION_SECRET / ETHERSCAN_API_KEY / OPENROUTER_*
# from above and hardcodes CHAIN_ID=11155111, the Sepolia explorer URLs, and
# DEFILLAMA_URL="" (the DefiLlama list is mainnet-only). USD is priced at the
# mainnet ETH rate via the shared CoinGecko endpoint. The only required var:
#
# --- required ---
# Sepolia JSON-RPC endpoint. MUST support debug_traceTransaction (structLogs).
SEPOLIA_RPC_URL=

# --- optional overrides (defaults shown) ---
# Sepolia's own egress rpc-proxy rate (requests/sec to the Sepolia upstream).
#SEPOLIA_RPC_PROXY_RATE=40
# Sepolia-specific in-process limiter (backstop behind the proxy). Burst must be
# >= 250; falls back to 100/250/8 if unset.
#SEPOLIA_RPC_RPS_BUDGET=100
#SEPOLIA_RPC_BURST=250
#SEPOLIA_RPC_MAX_CONCURRENCY=8
# Sepolia explorer links (default: sepolia.etherscan.io).
#SEPOLIA_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
#SEPOLIA_EXPLORER_ADDRESS_URL=https://sepolia.etherscan.io/address/
